# Local dev: leave unset. Vite's dev server proxies /api and /health to
# http://localhost:4000 (see vite.config.ts), so the frontend needs no API origin.
#
# Production: set to the deployed NestJS API's own origin (no trailing slash).
# The frontend and API are typically deployed to different hosts (e.g. Vercel
# for this Vite app, a Node host like Render/Railway/Fly for the API), so this
# must point at wherever apps/api actually runs.
# VITE_API_URL=https://ncct-api.onrender.com
